<?xml version="1.0" encoding="utf-8"?>
<!-- Isometric I-beam matching the in-app shape icons: the front profile (opaque) extruded edge by
     edge into a top face and a side face, respecting the web notch instead of a bounding box —
     so the beam reads as a real cut section, with the web's inner wall and the far flange's top
     peeking through the gap. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Caras laterales (más oscuras): borde derecho de cada tramo del ala superior/inferior y
         pared derecha del alma, cada una extruida por separado. -->
    <path
        android:pathData="M60,32 L60,39 L74,31 L74,24 Z"
        android:fillColor="@color/ic_launcher_foreground_side" />
    <path
        android:pathData="M50,39 L50,71 L64,63 L64,31 Z"
        android:fillColor="@color/ic_launcher_foreground_side" />
    <path
        android:pathData="M60,71 L60,78 L74,70 L74,63 Z"
        android:fillColor="@color/ic_launcher_foreground_side" />
    <!-- Caras superiores (más claras): borde de arriba del ala superior y las dos mitades del ala
         inferior, visibles a través de la muesca del alma. -->
    <path
        android:pathData="M32,32 L60,32 L74,24 L46,24 Z"
        android:fillColor="@color/ic_launcher_foreground_top" />
    <path
        android:pathData="M32,71 L42,71 L56,63 L46,63 Z"
        android:fillColor="@color/ic_launcher_foreground_top" />
    <path
        android:pathData="M50,71 L60,71 L74,63 L64,63 Z"
        android:fillColor="@color/ic_launcher_foreground_top" />
    <!-- Perfil frontal, encima de todo. -->
    <path
        android:pathData="M32,32 L60,32 L60,39 L50,39 L50,71 L60,71 L60,78 L32,78 L32,71 L42,71 L42,39 L32,39 Z"
        android:fillColor="@color/ic_launcher_foreground_glyph" />
</vector>
